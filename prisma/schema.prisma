generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id             String          @id @default(cuid())
  name           String
  email          String          @unique
  password       String
  role           String          @default("USER") // USER or ADMIN
  mobile         String?
  dob            String?
  gender         String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  orders         Order[]
  returnRequests ReturnRequest[]
  cartItems      CartItem[]
  wishlistItems  WishlistItem[]
  addresses      Address[]
  paymentMethods PaymentMethod[]
}

model Product {
  id              String         @id @default(cuid())
  name            String
  description     String
  price           Float
  originalPrice   Float
  discountPercent Int
  imageUrl        String
  category        String
  rating          Float          @default(4.5)
  reviewCount     Int            @default(0)
  inStock         Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  orderItems      OrderItem[]
  cartItems       CartItem[]
  wishlistItems   WishlistItem[]
}

model Order {
  id              String          @id
  userId          String
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  status          String          @default("PLACED") // PLACED, PROCESSING, SHIPPED, OUT_FOR_DELIVERY, DELIVERED, CANCELLED
  totalPrice      Float
  createdAt       DateTime        @default(now())
  estDeliveryDate DateTime?
  orderItems      OrderItem[]
  returnRequests  ReturnRequest[]
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int      @default(1)
  color     String?
  price     Float
}

model CartItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  createdAt DateTime @default(now())
}

model ReturnRequest {
  id           String   @id
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status       String   @default("PENDING") // PENDING, APPROVED, REJECTED, COMPLETED
  reason       String
  pickupDate   DateTime?
  timeSlot     String
  refundMethod String
  createdAt    DateTime @default(now())
}

model Address {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String
  street    String
  city      String
  state     String
  zipCode   String
  isDefault Boolean @default(false)
}

model PaymentMethod {
  id         String  @id @default(cuid())
  userId     String
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       String
  last4      String
  provider   String
  expiryDate String
  isDefault  Boolean @default(false)
}
